{
    "name": "moqo/craft-watchdog",
    "description": "Watchdog-connector: laat de Watchdog-server instellingen, formulieren en mislukte mails van een Craft-site uitlezen.",
    "type": "craft-plugin",
    "version": "1.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "MOQO",
            "homepage": "https://moqo.be"
        }
    ],
    "require": {
        "php": "^8.0.2",
        "craftcms/cms": "^4.0 || ^5.0"
    },
    "autoload": {
        "psr-4": {
            "moqo\\watchdog\\": "src/"
        }
    },
    "extra": {
        "handle": "watchdog",
        "name": "Watchdog-connector",
        "developer": "MOQO",
        "developerUrl": "https://moqo.be",
        "class": "moqo\\watchdog\\Plugin"
    }
}
